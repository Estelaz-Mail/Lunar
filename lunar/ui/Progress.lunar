<script>
  props { value = 0, max = 100, label = "Progresso" }
  percentage = max > 0 and math.max(0, math.min(100, value / max * 100)) or 0
</script>

<div class="lunaris-progress" role="progressbar" aria-label={label} aria-valuenow={value} aria-valuemin="0" aria-valuemax={max}><span style:width={percentage .. "%"}></span></div>

<style>
  .lunaris-progress { background: var(--lunar-surface-raised); border-radius: 999px; height: .5rem; overflow: hidden; width: 100%; }
  .lunaris-progress span { background: var(--lunar-brand); display: block; height: 100%; transition: width 200ms ease; }
</style>
