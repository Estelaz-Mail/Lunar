<script>
  props { name = "check", size = "1.25rem", label = "" }
  decorative = label == ""
</script>

<svg class="lunar-icon lunar-icon-{name}" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden={decorative} aria-label={decorative and nil or label}>
  {#if name == "check"}<path d="m5 12 4 4L19 6" />
  {:else if name == "x"}<path d="M6 6l12 12M18 6 6 18" />
  {:else if name == "plus"}<path d="M12 5v14M5 12h14" />
  {:else if name == "minus"}<path d="M5 12h14" />
