<script>
  local ReactIcon = import("lunar/ui/ReactIcon")
  props { name = "check", size = "1.25rem", label = "" }
  aliases = {
    check = "FaCheck",
    x = "FaTimes",
    plus = "FaPlus",
    minus = "FaMinus",
    ["arrow-left"] = "FaArrowLeft",
    ["arrow-right"] = "FaArrowRight",
    search = "FaSearch",
    lock = "FaLock",
    menu = "FaBars",
    sun = "FaSun",
    moon = "FaMoon",
    mail = "FaEnvelope",
    cloud = "FaCloud",
    rocket = "FaRocket",
    headset = "FaHeadset",
    mobile = "FaMobileAlt",
    shield = "FaShieldAlt",
    alert = "FaExclamationTriangle"
  }
  icon_name = aliases[name] or name
</script>

<ReactIcon name={icon_name} size={size} label={label} />
