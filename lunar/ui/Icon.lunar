  {:else if name == "mail"}<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
  {:else if name == "shield"}<path d="M12 3 5 6v5c0 4.5 2.8 8.2 7 10 4.2-1.8 7-5.5 7-10V6l-7-3Z" />
  {:else if name == "alert"}<path d="M12 3 2.5 20h19L12 3Z" /><path d="M12 9v4M12 17h.01" />{/if}
</svg>

