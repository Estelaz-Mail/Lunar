  {:else if name == "arrow-right"}<path d="m9 18 6-6-6-6M5 12h10" />
  {:else if name == "search"}<circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
  {:else if name == "lock"}<rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
  {:else if name == "menu"}<path d="M4 6h16M4 12h16M4 18h16" />
  {:else if name == "sun"}<circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
