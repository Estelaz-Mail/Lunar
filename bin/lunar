#!/bin/sh
# The Lunar CLI.
#
#   lunar dev [app]        serve an app, compiling on demand
#   lunar build [app]      compile everything once and report what failed
#   lunar map [app]        print the route table as it was discovered
#   lunar compile <file>   print the Lua a component compiles to
#   lunar wasm <file...>   compile Lua functions into wasm parts
#   lunar bench [app]      measure compiling, rendering, the takeover, the download
#   lunar bench --http <url>   measure a running server over keep-alive sockets
#   lunar workers [app]    generate a Cloudflare Workers deploy directory
#   lunar spec [name...]   run the tests
#
# LuaSocket is needed to serve; everything else runs on a bare Lua 5.4. If a
# LuaSocket is built into `.dev/modules`, it is used in preference to the
# system one, so the framework runs on a machine that has neither.
root="$(cd "$(dirname "$0")/.." && pwd)"
modules="$root/.dev/modules"

LUA_PATH="$root/?.lua;$root/?/init.lua;$modules/share/lua/5.4/?.lua;$modules/share/lua/5.4/?/init.lua;${LUA_PATH:-;}"
LUA_CPATH="$modules/lib/lua/5.4/?.so;${LUA_CPATH:-;}"
export LUA_PATH LUA_CPATH

command="${1:-help}"
[ $# -gt 0 ] && shift

case "$command" in
	spec) exec "${LUA:-lua5.4}" "$root/spec/runner.lua" "$@" ;;
	dev|build|map|compile|wasm|serve|workers|bench|help|--help|-h)
		exec "${LUA:-lua5.4}" "$root/lunar/cli.lua" "$command" "$@" ;;
	*)
		echo "lunar: unknown command '$command'" >&2
		exec "${LUA:-lua5.4}" "$root/lunar/cli.lua" help ;;
esac
