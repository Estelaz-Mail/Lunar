{
	"name": "lunar-website",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun scripts/build.ts",
		"check": "sh scripts/lunar.sh build .",
		"dev": "bun run build && wrangler dev --ip 127.0.0.1",
		"preview": "wrangler dev --ip 127.0.0.1",
		"deploy:check": "bun run build && wrangler deploy --dry-run",
		"deploy": "bun run build && wrangler deploy",
		"test": "bun run build && lua5.4 scripts/verify.lua && bun test worker/*.test.ts",
		"typecheck": "tsc -p ../tsconfig.json"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "22.20.5",
		"typescript": "5.9.3",
		"wrangler": "^4.152.0"
	}
}
