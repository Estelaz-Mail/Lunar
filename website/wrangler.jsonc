{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lunar-website",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "lunar.estelaz.com/*", "zone_name": "baioneta.com" }],
	"alias": {
		"fs": "./.lunar/workers/src/fs-stub.cjs",
		"tmp": "./.lunar/workers/src/tmp-stub.cjs",
		"readline-sync": "./.lunar/workers/src/absent.cjs",
		"child_process": "./.lunar/workers/src/absent.cjs",
	},
	"rules": [{ "type": "Text", "globs": ["**/*.lua"], "fallthrough": false }],
	"assets": { "directory": "./.lunar/workers/public", "binding": "ASSETS" },
	"observability": { "enabled": true, "head_sampling_rate": 1 },
}
