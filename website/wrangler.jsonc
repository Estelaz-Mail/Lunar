{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lunar-website",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "lunar.estelaz.com/*", "zone_name": "baioneta.com" }],
	"rules": [
		{ "type": "Text", "globs": ["**/*.lua"], "fallthrough": false },
		{ "type": "CompiledWasm", "globs": ["**/lua54.wasm"], "fallthrough": false },
	],
	"assets": { "directory": "./.lunar/workers/public", "binding": "ASSETS" },
	"observability": { "enabled": true, "head_sampling_rate": 1 },
}
