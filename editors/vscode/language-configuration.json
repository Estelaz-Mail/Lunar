{
	"comments": {
		"lineComment": "--",
		"blockComment": ["<!--", "-->"]
	},
	"brackets": [
		["<", ">"],
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] },
		{ "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["<", ">"],
		["\"", "\""],
		["'", "'"]
	],
	"autoCloseBefore": ";:.,=}])>`\n\t ",
	"indentationRules": {
		"increaseIndentPattern": "<(?!\\?|(?:area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)\\b|[^>]*/>)([-_\\.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*</\\1>)|\\{#(if|each)\\b[^}]*\\}(?!.*\\{/\\1\\})|\\{:else\\b[^}]*\\}|<!--(?!.*-->)|\\{[^}\"']*$|\\([^)\"']*$",
		"decreaseIndentPattern": "^\\s*(</[-_\\.A-Za-z0-9]+\\s*>|-->|\\{[:/](if|each|else)\\b[^}]*\\}|\\}|\\)|\\])"
	},
	"onEnterRules": [
		{
			"beforeText": "\\{#(if|each)\\b[^}]*\\}\\s*$",
			"action": { "indent": "indent" }
		},
		{
			"beforeText": "^\\s*\\{/(if|each)\\}\\s*$",
			"action": { "indent": "outdent" }
		}
	]
}
